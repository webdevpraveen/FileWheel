<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FileWheel.App"
             x:Class="FileWheel.App.App"
             Name="FileWheel"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <!-- Maps FooPageViewModel → FooPage view (see ViewLocator.cs). -->
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FileWheel/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://FileWheel/Styles/Brands.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://FileWheel/Styles/Soft.axaml" />
    <StyleInclude Source="avares://FileWheel/Styles/TagEditor.axaml" />
  </Application.Styles>
</Application>
